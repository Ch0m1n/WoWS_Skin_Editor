+fn apply_bind_pose(positions: &mut [[f32;3]], normals: &mut [[f32;3]], indices: &mut [u32],
+    data: &[u8], stride: usize, format: &VertexFormat, visual: &VisualPrototype,
+    rs: &crate::models::visual::RenderSet, strings: &crate::models::assets_bin::StringsSection<'_>)
+    -> Result<(), Report<ExportError>> {
+    let Some(bones)=format.attributes.iter().find(|a|a.semantic==AttributeSemantic::BoneIndices) else {return Ok(());};
+    let weights=format.attributes.iter().find(|a|a.semantic==AttributeSemantic::BoneWeights);
+    let palette: Vec<_>=rs.node_name_ids.iter().map(|id|strings.get_string_by_id(*id)
+        .and_then(|name|visual.find_hardpoint_transform(name,strings)).map(negate_z_transform)).collect();
+    if palette.is_empty(){return Ok(());}
+    apply_bind_palette(positions,normals,indices,data,stride,bones.offset,weights.map(|a|a.offset),&palette)
+}
+
+fn apply_bind_palette(positions: &mut [[f32;3]], normals: &mut [[f32;3]], indices: &mut [u32],
+    data: &[u8], stride: usize, bone_offset: usize, weight_offset: Option<usize>, palette: &[Option<[f32;16]>])
+    -> Result<(), Report<ExportError>> {
+    let mut reflected=Vec::with_capacity(positions.len());
+    for i in 0..positions.len(){
+        let base=i*stride;
+        // D3DCOLOR stores weights in BGRA order: R and G are the two explicit
+        // weights; the third is implicit. Indices address float3 matrix rows,
+        // so the palette index is the stored register offset divided by three.
+        let w=weight_offset.map(|offset|{let r=data[base+offset+2] as f32/255.0;let g=data[base+offset+1] as f32/255.0;[r,g,(1.0-r-g).max(0.0)]}).unwrap_or([1.0,0.0,0.0]);
+        let sum=w.iter().sum::<f32>();let mut m=[0.0;16];
+        for j in 0..3{
+            if w[j]<1e-7{continue;}
+            let register=data[base+bone_offset+j] as usize;
+            let bone=if register%3==0{palette.get(register/3).and_then(|m|*m)}else{None};
+            let Some(bone)=bone else{return Err(Report::new(ExportError::VertexDecode("invalid bind bone palette index".into())));};
+            for k in 0..16{m[k]+=bone[k]*w[j]/sum;}
+        }
+        let det=m[0]*(m[5]*m[10]-m[9]*m[6])-m[4]*(m[1]*m[10]-m[9]*m[2])+m[8]*(m[1]*m[6]-m[5]*m[2]);
+        reflected.push(det<0.0);
+        let n=if i<normals.len(){&mut normals[i..i+1]}else{&mut []};
+        apply_rigid_instance(&mut positions[i..i+1],n,&mut [],m);
+    }
+    for triangle in indices.chunks_exact_mut(3){
+        if triangle.iter().filter(|&&i|reflected[i as usize]).count()>=2{triangle.swap(0,2);}
+    }
+    Ok(())
+}
